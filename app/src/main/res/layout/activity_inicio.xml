<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 1. BARRA SUPERIOR DE BÚSQUEDA (FIJA ARRIBA) -->
    <LinearLayout
        android:id="@+id/ly_buscador"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_buscador"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="25dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_icono_lupa"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/hint_buscar"
            android:src="@drawable/ic_search"
            app:tint="@color/on_primary_container" />

        <TextView
            android:id="@+id/tv_buscar_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_regular"
            android:text="@string/hint_buscar"
            android:textColor="@color/on_primary_container"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 2. CONTENEDOR CON DESPLAZAMIENTO VERTICAL (ZONA CENTRAL) -->
    <ScrollView
        android:id="@+id/sv_contenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bnv_menu_inferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ly_buscador">

        <LinearLayout
            android:id="@+id/ly_cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- A. FILTROS RÁPIDOS DE EDAD (SCROLL HORIZONTAL) -->
            <HorizontalScrollView
                android:id="@+id/hsv_filtros_edad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ly_chips_edad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1 -->
                    <TextView
                        android:id="@+id/btn_filtro_edad_1"
                        android:layout_width="wrap_content"
                        android:layout_height="66dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_chip_edad"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="@string/filtro_edad_1"
                        android:textColor="@color/on_primary"
                        android:textSize="20sp" />

                    <!-- Chip 2 -->
                    <TextView
                        android:id="@+id/btn_filtro_edad_2"
                        android:layout_width="wrap_content"
                        android:layout_height="66dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_chip_edad"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="@string/filtro_edad_2"
                        android:textColor="@color/on_primary"
                        android:textSize="20sp" />

                    <!-- Chip 3 -->
                    <TextView
                        android:id="@+id/btn_filtro_edad_3"
                        android:layout_width="wrap_content"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_chip_edad"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="@string/filtro_edad_3"
                        android:textColor="@color/on_primary"
                        android:textSize="20sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- B. CATEGORÍAS PRINCIPALES (CÁPSULAS VERTICALES) -->
            <LinearLayout
                android:id="@+id/ly_categorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <!-- Cápsula Bebés -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_categoria_bebes"
                    android:layout_width="match_parent"
                    android:layout_height="139dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="21dp"
                        android:paddingEnd="21dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_categoria_bebes"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@color/primary_container"
                            android:contentDescription="@string/categoria_bebes"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        <TextView
                            android:id="@+id/tv_categoria_bebes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/categoria_bebes"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cápsula Niños -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_categoria_ninos"
                    android:layout_width="match_parent"
                    android:layout_height="139dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="21dp"
                        android:paddingEnd="21dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_categoria_ninos"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@color/primary_container"
                            android:contentDescription="@string/categoria_ninos"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        <TextView
                            android:id="@+id/tv_categoria_ninos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/categoria_ninos"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cápsula Niñas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_categoria_ninas"
                    android:layout_width="match_parent"
                    android:layout_height="139dp"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="21dp"
                        android:paddingEnd="21dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_categoria_ninas"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@color/primary_container"
                            android:contentDescription="@string/categoria_ninas"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        <TextView
                            android:id="@+id/tv_categoria_ninas"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/categoria_ninas"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- C. BLOQUE DE NOVEDADES -->
            <LinearLayout
                android:id="@+id/ly_seccion_novedades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- Barra título Novedades -->
                <TextView
                    android:id="@+id/tv_titulo_novedades"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@color/primary"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="@string/titulo_novedades"
                    android:textColor="@color/on_primary"
                    android:textSize="25sp" />

                <!-- Carrusel horizontal de productos de muestra -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Tarjeta Producto 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/item_producto_1"
                            android:layout_width="140dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="@color/surface_container"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/iv_producto_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="112dp"
                                    android:background="@color/primary_container"
                                    android:contentDescription="@string/producto_articulo"
                                    android:scaleType="centerCrop" />

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp">

                                    <TextView
                                        android:id="@+id/tv_titulo_producto_1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:fontFamily="@font/inter_regular"
                                        android:text="@string/producto_articulo"
                                        android:textColor="@color/primary"
                                        android:textSize="14sp" />

                                    <ImageView
                                        android:id="@+id/btn_favorito_1"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:contentDescription="@string/nav_favoritos"
                                        android:src="@drawable/ic_favorite"
                                        app:tint="@color/primary" />
                                </RelativeLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Tarjeta Producto 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/item_producto_2"
                            android:layout_width="140dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="@color/surface_container"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/iv_producto_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="112dp"
                                    android:background="@color/primary_container"
                                    android:contentDescription="@string/producto_articulo"
                                    android:scaleType="centerCrop" />

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp">

                                    <TextView
                                        android:id="@+id/tv_titulo_producto_2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:fontFamily="@font/inter_regular"
                                        android:text="@string/producto_articulo"
                                        android:textColor="@color/primary"
                                        android:textSize="14sp" />

                                    <ImageView
                                        android:id="@+id/btn_favorito_2"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:contentDescription="@string/nav_favoritos"
                                        android:src="@drawable/ic_favorite"
                                        app:tint="@color/primary" />
                                </RelativeLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Tarjeta Producto 3 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/item_producto_3"
                            android:layout_width="140dp"
                            android:layout_height="180dp"
                            app:cardBackgroundColor="@color/surface_container"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/iv_producto_3"
                                    android:layout_width="match_parent"
                                    android:layout_height="112dp"
                                    android:background="@color/primary_container"
                                    android:contentDescription="@string/producto_articulo"
                                    android:scaleType="centerCrop" />

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp">

                                    <TextView
                                        android:id="@+id/tv_titulo_producto_3"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:fontFamily="@font/inter_regular"
                                        android:text="@string/producto_articulo"
                                        android:textColor="@color/primary"
                                        android:textSize="14sp" />

                                    <ImageView
                                        android:id="@+id/btn_favorito_3"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:contentDescription="@string/nav_favoritos"
                                        android:src="@drawable/ic_favorite"
                                        app:tint="@color/primary" />
                                </RelativeLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3. BARRA DE NAVEGACIÓN INFERIOR (ANCLADA AL FONDO) -->
    <LinearLayout
        android:id="@+id/bnv_menu_inferior"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Destino 1: Inicio (Activo) -->
        <LinearLayout
            android:id="@+id/btn_nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_inicio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_inicio"
                android:src="@drawable/ic_home"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tv_nav_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/nav_inicio"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Destino 2: Catálogo -->
        <LinearLayout
            android:id="@+id/btn_nav_catalogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_catalogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_catalogo"
                android:src="@drawable/ic_catalog"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tv_nav_catalogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/nav_catalogo"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Destino 3: Favoritos -->
        <LinearLayout
            android:id="@+id/btn_nav_favoritos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_favoritos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_favoritos"
                android:src="@drawable/ic_favorite"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tv_nav_favoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/nav_favoritos"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>